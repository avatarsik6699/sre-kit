# Copy to .env (or otherwise export these into the process environment) before starting the
# server. See internal/platform/config/config.go for defaults and validation.

# host:port the HTTP server listens on.
SRE_KIT_ADDR=:8080

# Filesystem path to the SQLite database file. Created (with parent dirs) on first run.
SRE_KIT_DB_PATH=./data/sre-kit.db

# Filesystem path to the encrypted secrets store (adapter secrets, admin password hash — see
# docs/SPEC.md §3, §6). Created on first run.
SRE_KIT_SECRETS_PATH=./data/secrets.enc.json

# Symmetric encryption key for the secrets store. REQUIRED — the process refuses to start without
# it. Generate one with, e.g.: openssl rand -hex 32
# Losing this key makes secrets.enc.json permanently unreadable (adapter secrets, admin password).
SRE_KIT_SECRETS_KEY=

# Directory the adapter engine scans for installed adapter subprocesses (each in its own
# subdirectory with a manifest.json — see adapters/stub for an example).
SRE_KIT_ADAPTERS_DIR=./adapters
