{
  "steps": [
    {
      "type": "ssh_command",
      "command": "docker compose exec -T beszel beszel superuser upsert {{.AdminEmail}} {{.AdminPassword}}"
    },
    {
      "type": "http_call",
      "method": "POST",
      "path_template": "/api/collections/_superusers/auth-with-password",
      "body_template": "{\"identity\":\"{{.AdminEmail}}\",\"password\":\"{{.AdminPassword}}\"}",
      "capture_field": "token",
      "capture_as": "token"
    },
    {
      "type": "http_call",
      "method": "POST",
      "path_template": "/api/collections/systems/records",
      "auth_from_field": "token",
      "body_template": "{\"name\":\"{{.HostAddress}}\",\"host\":\"/beszel_socket/beszel.sock\",\"port\":\"45876\",\"users\":[]}",
      "capture_field": "id",
      "capture_as": "system_id"
    }
  ]
}
