services:
  umami-db:
    image: postgres:15-alpine
    container_name: umami-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: umami
      POSTGRES_USER: umami
      POSTGRES_PASSWORD: umami
    volumes:
      - ./umami_db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U umami"]
      interval: 5s
      timeout: 5s
      retries: 10

  umami:
    image: ghcr.io/umami-software/umami:postgresql-latest
    container_name: umami
    restart: unless-stopped
    ports:
      - 3001:3000
    environment:
      DATABASE_URL: postgresql://umami:umami@umami-db:5432/umami
      # Reuses the workflow's generated admin password as Umami's JWT-signing secret too — one
      # generated value, avoids a second random-secret path for a single-run deploy stack.
      APP_SECRET: {{.AdminPassword}}
    depends_on:
      umami-db:
        condition: service_healthy
