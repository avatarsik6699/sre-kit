{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sre-kit.local/contract.schema.json",
  "title": "sre-kit data contract",
  "description": "Versioned wire contract for the three telemetry records an adapter may emit as NDJSON lines (metric, check, event) plus the core-generated alert entity used on core-owned wire surfaces, per docs/SPEC.md §4. schema_version is \"1.0\". Versioning rule: this schema is additive-only within a major version — new optional fields or new \"type\" variants may be added without a version bump beyond documenting them here; removing or repurposing an existing field, or changing an existing field's meaning/type, requires a major version bump (e.g. \"2.0\") and is a breaking change. Remote actions and deployment primitives are outside this observability contract.",
  "oneOf": [
    { "$ref": "#/$defs/metric" },
    { "$ref": "#/$defs/check" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/alert" }
  ],
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["type", "source_id", "name", "timestamp", "value"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "metric" },
        "source_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "value": { "type": "number" },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["type", "source_id", "name", "timestamp", "status"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "check" },
        "source_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["ok", "warn", "critical"] },
        "meta": { "type": "object" }
      }
    },
    "event": {
      "type": "object",
      "required": ["type", "source_id", "timestamp", "level", "message"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "event" },
        "source_id": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "level": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "alert": {
      "type": "object",
      "description": "Core-generated only — never emitted directly by an adapter (docs/SPEC.md §4). Included here for wire-contract completeness (e.g. the WS stream).",
      "required": ["type", "source_id", "severity", "message", "created_at"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "alert" },
        "source_id": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["warn", "critical"] },
        "message": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "resolved_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
